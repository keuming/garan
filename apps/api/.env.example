# ---- Serveur ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Nombre de proxys devant l'API (Render = 1) pour obtenir la vraie IP client
TRUST_PROXY=1

# ---- Base de données (Neon : utiliser l'URL "pooled" pour l'API) ----
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/garan?sslmode=require
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# ---- Sécurité ----
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=remplacer-par-une-valeur-aleatoire-de-48-octets-minimum
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PIN_MAX_ATTEMPTS=5
PIN_LOCK_MINUTES=15
BCRYPT_ROUNDS=10

# ---- Application ----
# Origines autorisées pour le back-office web (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173
# URL publique du site web (liens des certificats QR : <PUBLIC_WEB_URL>/v/<code>)
PUBLIC_WEB_URL=http://localhost:5173

# URL publique DE L'API elle-même (sert à construire les liens des photos d'articles).
# EN PRODUCTION : mettre https://garan-api.onrender.com  (sinon les photos de la vitrine ne s'afficheront pas)
API_PUBLIC_URL=http://localhost:4000

# Intégration ORZAYAH (paiement digital + solde). Laisser ORZAYAH_API_URL vide tant que non câblé.
ORZAYAH_PAY_URL=https://pay.orzayah.com
ORZAYAH_API_URL=
ORZAYAH_API_KEY=
DEFAULT_COUNTRY_CODE=225
TRIAL_DAYS=14

# ---- Stockage des pièces d'identité ----
# local (développement), db (photos dans PostgreSQL, sans service externe) ou s3 (Cloudflare R2, AWS S3…)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
UPLOAD_MAX_MB=5
# S3_BUCKET=garan-id-docs
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
